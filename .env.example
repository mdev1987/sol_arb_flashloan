# ── Required ──────────────────────────────────────────────────────────────────
HELIUS_API_KEY=              # Helius RPC + priority fees + sender
JUPITER_API_KEY=             # Jupiter Swap V2 + flash loan

# ── Mode (SIMULATION ONLY — LIVE mode not yet enabled) ───────────────────────
MODE=SIMULATE                # SIMULATE | SHADOW (LIVE rejected at startup)

# ── Wallet (only needed for SHADOW mode with realized PnL tracking) ──────────
PRIVATE_KEY=                 # base58 throwaway wallet (auto-generated if empty)

# ── Strategy ─────────────────────────────────────────────────────────────────
MAX_TRADE_USDC=500
MIN_PROFIT_BPS=10
MIN_PROFIT_USDC=0.5
MAX_SLIPPAGE_BPS=100
JUPITER_QUOTE_MODE=fast      # fast | default
JUPITER_RTSE=true            # real-time slippage estimator

# ── DEX pairs (optional — if empty, scans all built-in pairs) ─────────────
# Format: "RAYDIUM CLMM>Whirlpool;Whirlpool>Raydium CPMM"
DEX_PAIRS=

# ── Execution ────────────────────────────────────────────────────────────────
POLL_INTERVAL_MS=5000
MAX_TX_BYTES=1232
MAX_COMPUTE_UNITS=1400000
CU_MARGIN_BPS=1000
MIN_SOL_RESERVE=0.05

# ── Priority fees ────────────────────────────────────────────────────────────
PRIORITY_FEE_LEVEL=veryHigh  # min | low | medium | high | veryHigh | unsafeMax

# ── Sender tips ──────────────────────────────────────────────────────────────
SENDER_MODE=swqos            # max | swqos
MIN_SENDER_TIP_LAMPORTS=5000
MAX_SENDER_TIP_LAMPORTS=100000000
MAX_TIP_PROFIT_PCT=5

# ── Flash loans ──────────────────────────────────────────────────────────────
FLASH_LOAN_PROVIDER=jupiter  # none | jupiter

# ── Events (WebSocket) ──────────────────────────────────────────────────────
EVENTS_ENABLED=true
WATCH_DEX_PROGRAMS=true      # Watch all 6 DEX programs
WATCH_ACCOUNTS=              # Specific accounts to watch (comma-separated)

# ── Rate limiting ────────────────────────────────────────────────────────────
JUPITER_RATE_LIMIT_RPS=1

# ── Telegram (optional) ─────────────────────────────────────────────────────
BOT_TOKEN=                 # Telegram bot token
CHAT_ID=                   # Telegram chat ID
