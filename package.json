{
  "name": "sol-arb-flashloan",
  "version": "1.0.0",
  "description": "Solana cross-DEX arbitrage bot — simulation-first with event-driven detection, two-stage simulation, and full cost modeling.",
  "module": "src/index.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "start": "bun run src/index.ts",
    "dev": "bun --watch run src/index.ts",
    "build": "bun build src/index.ts --outdir ./dist --target bun",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@jup-ag/lend": "0.2.0",
    "@solana/spl-token": "^0.4.15",
    "@solana/web3.js": "^1.98.4",
    "bn.js": "^5.2.5",
    "bs58": "^6.0.0",
    "dotenv": "^17.4.2",
    "gramio": "^0.14.0",
    "pino": "^10.3.1",
    "telegram-markdown-v2": "^0.0.5",
    "ws": "^8.18.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/bn.js": "^5.2.0",
    "@types/bun": "latest",
    "@types/node": "^22.15.0",
    "@types/ws": "^8.5.13",
    "typescript": "^5"
  }
}
